<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link do OAuth (fluxo A). O esquema é br.com.queroumacor.app
                 (o que lib/native/auth.ts usa em NATIVE_OAUTH_REDIRECT), declarado
                 EXPLICITAMENTE — NÃO derivado do applicationId (br.com.queroumacor),
                 senão o callback não bateria. Já está nas Redirect URLs do Supabase. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="br.com.queroumacor.app" android:host="auth" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push nativo (Android 13+): sem esta permissão o plugin FirebaseMessaging
         nunca consegue mostrar notificação; a concessão em runtime é pedida por
         registerNativePush → requestPermissions em lib/native/push.ts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Câmera. O @capacitor/camera NÃO injeta esta permissão sozinho (a doc dele
         manda declarar aqui), e sem ela dois caminhos morrem de uma vez: o
         Camera.getPhoto() nativo E o getUserMedia do components/CameraCapture.tsx,
         porque a WebView só concede VIDEO_CAPTURE se o app tiver a permissão. O
         CameraCapture é justamente a saída de emergência de quando a galeria não
         abre — sem isso o pintor fica sem nenhum caminho pra foto.
         O AAB do WebIntoApp declarava CAMERA; o primeiro AAB Capacitor (10200)
         não, e foi por isso que ele não foi testado em campo. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required="false" é obrigatório aqui: declarar a permissão CAMERA faz o
         Play EXIGIR implicitamente o hardware de câmera e sumir com o app dos
         aparelhos que não têm uma. O app funciona sem câmera (a foto vira
         galeria/navegador), então a exigência não pode existir. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
